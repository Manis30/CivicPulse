{
  "name": "civicpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CivicPulse - Autonomous Civic Incident Operations Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@civicpulse/api",
    "dev:web": "npm run dev --workspace=@civicpulse/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=@civicpulse/api",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "civic-operations",
    "ai-agents",
    "digital-twin",
    "incident-management"
  ],
  "author": "CivicPulse Core Architecture Team",
  "license": "UNLICENSED"
}
