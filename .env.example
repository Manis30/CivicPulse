# ==========================================
# CivicPulse Environment Configuration
# ==========================================

# Backend API Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Database & Queue Configuration (Future Phases)
MONGODB_URI=mongodb://127.0.0.1:27017/civicpulse
REDIS_URL=redis://127.0.0.1:6379

# Security & Authentication
JWT_SECRET=super_secret_development_jwt_key_civicpulse_2026_enterprise_do_not_use_in_prod
JWT_EXPIRATION=7d

# AI Engine Credentials (Never expose to frontend client)
# Optional: If omitted, platform operates in high-precision DETERMINISTIC_ENGINE mode
GEMINI_API_KEY=

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Frontend Configuration (Used by apps/web)
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
VITE_APP_NAME="CivicPulse Operations"
VITE_CESIUM_ION_TOKEN=
VITE_MAPBOX_TOKEN=
